# kkl-web environment.
#
# This repository must never hold secrets. Nothing here is a credential, an API key,
# a payment key, or a signing secret. Those live in kkl-backend and its host's secret
# manager. If a value you are about to add would be damaging to leak, it does not
# belong in this repository — it belongs behind the kkl-backend API.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are world-readable.

# Which environment this BUILD is for. Compiled into the bundle, and compared
# against the server's KKL_ENV on every request: a mismatch is a 503, because
# a bundle built for one environment and deployed as another cannot be trusted
# to describe what it is talking to.
#   development | review | staging | production
#
# `staging` is a URL anyone can open, carrying synthetic data, for testing.
# It does NOT get production's rule (refuse `sample` outright) — it cannot,
# because the platform-wide `api` client does not exist, and a guard nobody can
# satisfy gets bypassed rather than met. It gets the narrower rule that closes
# the actual hole: KKL_AUTH must be `backend`, so the session is a real one,
# and no development-issuer secret may be present. See
# docs/phase-2/brand-revision.md and src/lib/config/runtime.ts.
NEXT_PUBLIC_KKL_ENV=development

# Base URL of the kkl-backend versioned REST API, e.g. https://api.example.invalid/api/v1
# Required when NEXT_PUBLIC_KKL_DATA_SOURCE=api. Absent in sample mode.
NEXT_PUBLIC_KKL_API_BASE_URL=

# Where screen data comes from: "sample" or "api".
#
#   sample  Sample-data services. Nothing is real: no payment is taken, no OTP is sent,
#           no message is delivered, no account is authenticated. The UI must say so.
#   api     The real kkl-backend API. Requires NEXT_PUBLIC_KKL_API_BASE_URL; fails closed
#           without it rather than silently falling back to sample data.
#
# Defaults to "sample" when unset.
NEXT_PUBLIC_KKL_DATA_SOURCE=sample

# The server's own declarations, read fresh on every request. These are the
# authoritative pair; the NEXT_PUBLIC_ values above are frozen at build time and
# only say what the bundle was built as. A served build (NODE_ENV=production)
# must set both or it refuses to serve at all, so "nobody configured this" is a
# visible failure rather than a silent fallback.
# KKL_ENV=review
# KKL_DATA_SOURCE=sample

# Runtime only — no NEXT_PUBLIC_ prefix, so it is not compiled into the bundle.
# Unset: the sign-in screen stays the sample step (any six digits, nothing sent).
# KKL_AUTH=backend calls kkl-backend POST /v1/auth/* and does not accept a code locally.
# It needs KKL_BACKEND_BASE_URL or KKL_LEAD_REQUESTS_BASE_URL on the server.
# The refresh token is an httpOnly cookie. Do not add a NEXT_PUBLIC_ variable for it.
#
# KKL_STAFF_ORDERS=backend reads GET /v1/orders?scope=all (offset and limit) and the order detail.
# KKL_INTAKE=backend reads the intake batch list (offset and limit) and the batch detail.
# Both follow KKL_AUTH: backend uses the signed-in session, and unset keeps
# the labelled development staff identity. Neither switch invents an INR
# amount, an organisation, a delivery timeline, or a masked phone number.
#
# KKL_QUALIFICATION=backend reads staff qualification runs, question sets,
# calling-window and opt-out against the same KKL_BACKEND_BASE_URL (or
# KKL_LEAD_REQUESTS_BASE_URL). Phase 4 review is http://127.0.0.1:4011.
# Phase 5 review is http://127.0.0.1:4012. Point every enabled adapter at
# one of those origins. Do not mix them with each other or with Phase 3
# on 4010.
# Leave KKL_ALLOW_LIVE_CALLS and KKL_ALLOW_LIVE_MESSAGING unset.

# ------------------------------------------- must not be set on a public URL
# Each of these exists to call kkl-backend's development identity issuer,
# which invents an account for a name with whatever role is asked for. The
# backend returns 404 for that issuer on a staging or production deployment,
# and kkl-web refuses to serve at all if any of the three is present there, so
# the failure is one start-up error instead of a run of 404s nobody traces.
# KKL_AUTH=backend needs none of them.
# KKL_DEV_AUTH_SECRET=
# KKL_BACKEND_DEV_SECRET=
# KKL_LEAD_REQUESTS_DEV_SECRET=
